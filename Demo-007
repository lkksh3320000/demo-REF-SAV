    ctx: null, enabled: false,
    init: function() { if(this.ctx) return; window.AudioContext = window.AudioContext || window.webkitAudioContext; this.ctx = new AudioContext(); this.enabled = true; },
    playTone: function(freq, type, duration, vol=0.1) {
