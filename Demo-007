<script>
/** ==========================================
 *  一、基礎建設與核心狀態 (Infrastructure)
 *  ========================================== */
window.GG = window.GG || {};
if (!window.GG.config) {
    window.GG.config = Object.freeze({ version: 'Demo-007', fps_target: 60, fps_redline: 35, save_schema: 1 });
}
window.GG.state = window.GG.state || {
    player: { level: 1, realm: '練氣期', hp_current: 100, hp_max: 100, mp_current: 50, mp_max: 50, atk: 10, def: 5, luck: 80, int: 80, cha: 100, exp: 0, exp_next: 150, traits: [] },
    inventory: { spirit_stones: 0, cores: 0, irons: 0, items: {} },
    appearance: { face: 1, hair: 1, clothes: 1 },
    mastery: {}
};
window.GG.runtime = window.GG.runtime || { paused: false, last_frame_time: null };

// 雙槽存檔與雜湊校驗
window.GG.save = (() => {
    const KEYS = ['guigu.save.v7.a', 'guigu.save.v7.b'];
    function fnv1a(str) {
        let h = 0x811c9dc5; for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 0x01000193); }
        return (h >>> 0).toString(16).padStart(8, '0');
    }
    function save(stateObj) {
        let payload = JSON.stringify(stateObj);
        let env = JSON.stringify({ payload: payload, sum: fnv1a(payload), time: Date.now() });
        try { localStorage.setItem(KEYS[0], env); return true; } catch(e) { return false; }
    }
    function load() {
        try {
            let raw = localStorage.getItem(KEYS[0]); if (!raw) return null;
            let env = JSON.parse(raw);
            if (fnv1a(env.payload) !== env.sum) return null;
            return JSON.parse(env.payload);
        } catch(e) { return null; }
    }
    return { save, load };
})();

// 嘗試載入存檔
let loadedState = window.GG.save.load();
if (loadedState) window.GG.state = loadedState;

window.GG.res = (() => {
    const PATHS = {
        'stones': { get: s => s.inventory.spirit_stones, set: (s,v) => s.inventory.spirit_stones = Math.max(0,v) },
        'cores':  { get: s => s.inventory.cores, set: (s,v) => s.inventory.cores = Math.max(0,v) },
        'irons':  { get: s => s.inventory.irons, set: (s,v) => s.inventory.irons = Math.max(0,v) },
        'hp':     { get: s => s.player.hp_current, set: (s,v) => s.player.hp_current = Math.max(0, Math.min(v, s.player.hp_max)) }
    };
    function change(path, delta) {
        if(!PATHS[path] || !Number.isFinite(delta)) return false;
        PATHS[path].set(window.GG.state, PATHS[path].get(window.GG.state) + delta);
        window.GG.save.save(window.GG.state); // 自動存檔
        return true;
    }
    return { add: (p, n) => change(p, Math.abs(n)), sub: (p, n) => change(p, -Math.abs(n)) };
})();

window.GG.traits = [
    { name: "鬼谷外門", desc: "攻擊力+10，悟性+30，魅力+100", color: "#ff4757", apply: (p) => { p.atk+=10; p.int+=30; p.cha+=100; } },
    { name: "人族聖體", desc: "攻擊力+8，體力上限+150，幸運+10", color: "#ff4757", apply: (p) => { p.atk+=8; p.hp_max+=150; p.hp_current+=150; p.luck+=10; } },
    { name: "武聖轉世", desc: "攻擊力+10，防禦力+5，悟性+20", color: "#ffa502", apply: (p) => { p.atk+=10; p.def+=5; p.int+=20; } },
    { name: "天命之子", desc: "幸運+50，魅力+200", color: "#ffa502", apply: (p) => { p.luck+=50; p.cha+=200; } }
];

window.GG.materials = {
    breakthrough: ["葬沙骨", "朝夕露", "暖玉", "夕顏", "鬼哭藤", "北冥幽魄", "鳳凰果", "九彩鈴蘭"],
    pills: [{ id: 'huayu', name: '一品化瘀丹', type: 'heal', desc: '瞬間恢復大量體力' }]
};

/** ==========================================
 *  二、動態難度與美術引擎 (Wave & Art)
 *  ========================================== */
window.GG.wave = (() => {
    let currentPhase = 0; const MAX_ENEMIES_ON_SCREEN = 150;
    function getDifficulty(time, maxTime) {
        let t = Math.min(1.0, time / maxTime); let phase = Math.min(4, Math.floor(t * 5)); currentPhase = phase;
        let phaseMulti = 1 + (phase * 0.5) + Math.pow(1.5, phase);
        return { hpMulti: phaseMulti * (1 + t * 2.5), dmgMulti: phaseMulti * (1 + t * 1.5), t: t };
    }
    function tick(dt, time, maxTime, currentEnemyCount) {
        if (currentEnemyCount >= MAX_ENEMIES_ON_SCREEN) return null;
        let t = Math.min(1.0, time / maxTime);
        return Math.max(0.08, 1.2 - (t * 0.9) - (0.3 * Math.sin(t * Math.PI * 6)));
    }
    return { getDifficulty, tick, getPhase: () => currentPhase };
})();

window.GG.art = {
    max: { hair: 3, face: 2, clothes: 3 },
    hair: [
        (ctx) => { ctx.fillStyle='#d35400'; ctx.beginPath(); ctx.arc(28,20,1,0,Math.PI*2); ctx.arc(36,20,1,0,Math.PI*2); ctx.fill(); },
        (ctx) => { ctx.fillStyle = '#111'; ctx.beginPath(); ctx.arc(32, 26, 15, Math.PI, 0); ctx.moveTo(17, 26); ctx.lineTo(17, 36); ctx.lineTo(23, 26); ctx.moveTo(47, 26); ctx.lineTo(47, 36); ctx.lineTo(41, 26); ctx.fill(); ctx.beginPath(); ctx.arc(32, 12, 6, 0, Math.PI*2); ctx.fill(); ctx.fillStyle = '#c9a562'; ctx.fillRect(28, 14, 8, 2); },
        (ctx) => { ctx.fillStyle = '#2c3e50'; ctx.beginPath(); ctx.moveTo(15, 30); ctx.quadraticCurveTo(32, 5, 49, 30); ctx.lineTo(55, 45); ctx.lineTo(42, 25); ctx.lineTo(32, 22); ctx.lineTo(22, 25); ctx.lineTo(9, 45); ctx.fill(); },
        (ctx) => { ctx.fillStyle = '#ecf0f1'; ctx.beginPath(); ctx.arc(32, 26, 14, Math.PI, 0); ctx.fill(); ctx.fillRect(18, 26, 28, 20); }
    ],
    face: [
