class Player {
    constructor(sect) {
        this.x = 0; this.y = 0; this.radius = 15;
        let pState = window.GG.state.player;
        this.speed = 160 + (pState.atk * 1.5); 
        this.maxHp = pState.hp_max; this.hp = pState.hp_current;
        this.pickupRadius = 60 + (pState.int * 1);
        this.expMulti = 1 + (pState.int * 0.02);
        this.weapons = [];
        if(sect === 'sword') this.addWeapon('清風劍氣', 'projectile', 15, 1.0, 'normal', 1);
        else if(sect === 'magic') this.addWeapon('三昧真火', 'projectile', 25, 1.5, 'fire', 2);
        else this.addWeapon('玄冰護盾', 'orbit', 10, 0, 'ice', 99, 60);
        this.magnetTimer = 0;
    }
    addWeapon(name, type, dmg, cd, el, pierce, radius=0) {
        let w = this.weapons.find(x=>x.name===name);
        if(w) w.level++; else this.weapons.push({name, type, level:1, baseDmg: dmg, baseCd: cd, timer:0, element: el, pierce, radius, angle:0});
    }
    update(dt) {
        let ix = Math.abs(kbInput.x) > Math.abs(joyInput.x) ? kbInput.x : joyInput.x; let iy = Math.abs(kbInput.y) > Math.abs(joyInput.y) ? kbInput.y : joyInput.y;
        if(ix !== 0 || iy !== 0) { let len = Math.hypot(ix, iy); this.x += (ix/len)*this.speed*dt; this.y += (iy/len)*this.speed*dt; }
        gameState.camera.x = this.x - canvas.width / 2; gameState.camera.y = this.y - canvas.height / 2;
        if (this.magnetTimer > 0) this.magnetTimer -= dt;

        this.weapons.forEach(w => {
            let masteryLvl = window.GG.state.mastery[w.name] || 0;
            let actualDmg = w.baseDmg * (1 + (window.GG.state.player.atk * 0.05)) * (1 + masteryLvl * 0.015) * (1 + (w.level-1)*0.2);
            w.timer -= dt;
            if(w.timer <= 0) {
                if (w.type === 'projectile') { if (this.fireProjectile(w, actualDmg)) w.timer = Math.max(0.1, w.baseCd); }
            }
        });
    }
    fireProjectile(w, actualDmg) {
        if(enemies.length === 0) return false;
        let closest = enemies.reduce((c, e) => { let d = Math.hypot(this.x - e.x, this.y - e.y); return d < c.d ? {e: e, d: d} : c; }, {e: null, d: Infinity});
        if (closest.e && closest.d < 600) {
            let dx = closest.e.x - this.x; let dy = closest.e.y - this.y; let len = Math.hypot(dx, dy);
            projectiles.push(new Projectile(this.x, this.y, dx/len, dy/len, actualDmg, w.name, w.element, w.pierce));
            SoundManager.shoot(); return true;
        } return false;
    }
    gainExp(amt) {
        window.GG.state.player.exp += amt * this.expMulti;
        if(window.GG.state.player.exp >= window.GG.state.player.exp_next) { 
            window.GG.state.player.exp -= window.GG.state.player.exp_next; 
            window.GG.state.player.level++; 
            window.GG.state.player.exp_next = Math.floor(window.GG.state.player.exp_next * 1.5); 
            triggerLevelUp(); 
        }
        UI.expBar.style.width = `${(window.GG.state.player.exp / window.GG.state.player.exp_next) * 100}%`;
    }
}

class Companion {
    constructor(x, y) { this.x = x; this.y = y; this.radius = 12; this.speed = 180; this.markedForDeath = false; this.hp = 500; this.maxHp = 500; this.timer = 60; this.damage = 25; }
    update(dt) {
        this.timer -= dt; if(this.timer <= 0) this.markedForDeath = true;
        let dx = player.x - this.x; let dy = player.y - this.y; let d = Math.hypot(dx,dy);
        if(d > 80) { this.x += (dx/d)*this.speed*dt; this.y += (dy/d)*this.speed*dt; }
    }
    draw(ctx, cam) {
        let dx = this.x - cam.x; let dy = this.y - cam.y;
        ctx.fillStyle = 'rgba(0,0,0,0.4)'; ctx.beginPath(); ctx.ellipse(dx, dy + 8, 12, 6, 0, 0, Math.PI*2); ctx.fill();
        ctx.fillStyle = '#2980b9'; ctx.beginPath(); ctx.arc(dx, dy, this.radius, 0, Math.PI*2); ctx.fill();
        ctx.strokeStyle = '#00f2fe'; ctx.lineWidth = 2; ctx.stroke();
    }
}

class Enemy {
    constructor(x, y, type) {
        this.x = x; this.y = y; this.type = type; this.markedForDeath = false; this.attackCooldown = 0;
        this.status = { burn: 0, burnTick: 0, freeze: 0, poison: 0 };
        let diff = window.GG.wave.getDifficulty(gameState.time, gameState.maxTime);
        let baseHp = 30; let baseDmg = 10; let baseSpeed = 50;
        if(type === 'boss') { baseHp = 5000; baseDmg = 40; baseSpeed = 70; this.radius = 35; this.color = '#f1c40f'; }
        else if(type.includes('elite')) { baseHp = 1000; baseDmg = 25; baseSpeed = 60; this.radius = 25; this.color = '#c0392b'; }
        else { baseHp = 30; baseDmg = 10; baseSpeed = 50 + (Math.random()*25); this.radius = 12; this.color = '#2ecc71'; }
        this.maxHp = baseHp * diff.hpMulti; this.damage = baseDmg * diff.dmgMulti; this.hp = this.maxHp; this.speed = baseSpeed;
    }
    update(dt) {
        let dx = player.x - this.x; let dy = player.y - this.y; let len = Math.hypot(dx, dy);
        if(len > 0) { this.x += (dx/len) * this.speed * dt; this.y += (dy/len) * this.speed * dt; }
        if (this.attackCooldown > 0) this.attackCooldown -= dt;
        if (len < this.radius + player.radius && this.attackCooldown <= 0) { takePlayerDamage(this.damage); this.attackCooldown = 1.0; }
    }
    takeDamage(dmg, sourceWeapon) {
        this.hp -= dmg; floatTexts.push(new FloatText(this.x, this.y - 20, Math.floor(dmg), '#fff'));
        if(sourceWeapon) window.GG.state.mastery[sourceWeapon] = (window.GG.state.mastery[sourceWeapon] || 0) + 1;
        if(this.hp <= 0 && !this.markedForDeath) {
            this.markedForDeath = true; gameState.kills++; SoundManager.hit();
            if (this.type.includes('boss')) { drops.push(new Drop(this.x, this.y, 'chest')); window.GG.res.add('cores', 2); }
            else if (this.type.includes('elite')) { 
                let mats = window.GG.materials.breakthrough;
                let d = new Drop(this.x, this.y, 'material'); d.matName = mats[Math.floor(Math.random()*mats.length)]; drops.push(d);
                window.GG.res.add('irons', 3); 
            } else {
                if(Math.random() < 0.1) window.GG.res.add('stones', 1); else drops.push(new Drop(this.x, this.y, 'exp', 5));
            }
        }
    }
}

class Projectile {
    constructor(x, y, vx, vy, dmg, name, el, pierce) {
        this.x = x; this.y = y; this.vx = vx; this.vy = vy; this.speed = 500; 
        this.damage = dmg; this.life = 2.0; this.markedForDeath = false; this.element = el; this.pierce = pierce; this.hitTargets = []; this.name = name;
    }
    update(dt) {
        this.x += this.vx * this.speed * dt; this.y += this.vy * this.speed * dt;
        this.life -= dt; if(this.life <= 0) this.markedForDeath = true;
        for(let e of enemies) {
            if(Math.hypot(this.x - e.x, this.y - e.y) < e.radius + 10 && !this.hitTargets.includes(e)) {
                e.takeDamage(this.damage, this.name); this.hitTargets.push(e); this.pierce--;
                if(this.pierce <= 0) { this.markedForDeath = true; break; }
            }
        }
    }
    draw(ctx, cam) {
        let dx = this.x - cam.x; let dy = this.y - cam.y;
        let angle = Math.atan2(this.vy, this.vx); ctx.save(); ctx.translate(dx, dy); ctx.rotate(angle);
        ctx.fillStyle = '#ecf0f1'; ctx.strokeStyle = '#3498db'; ctx.lineWidth=2;
        ctx.beginPath(); ctx.moveTo(10, 0); ctx.lineTo(-10, 5); ctx.lineTo(-10, -5); ctx.closePath(); ctx.fill(); ctx.stroke();
        ctx.restore();
    }
}

class Drop {
    constructor(x, y, type, expVal=0) { this.x = x; this.y = y; this.type = type; this.exp = expVal; this.markedForDeath = false; }
    update(dt) {
        let dist = Math.hypot(player.x - this.x, player.y - this.y);
        if(dist < player.pickupRadius) {
            this.markedForDeath = true; SoundManager.pickup();
            if(this.type === 'material') {
                window.GG.state.inventory.items[this.matName] = (window.GG.state.inventory.items[this.matName] || 0) + 1;
                floatTexts.push(new FloatText(player.x, player.y, `獲得【${this.matName}】`, '#00f2fe'));
            } else if(this.type === 'stones') { window.GG.res.add('stones', 5); }
            else { player.gainExp(this.exp); }
        }
    }
    draw(ctx, cam) {
        let dx = this.x - cam.x; let dy = this.y - cam.y + Math.sin(gameState.time * 5) * 4;
        if(this.type === 'material') { ctx.font = "18px Arial"; ctx.fillText("🌿", dx, dy); }
        else { ctx.fillStyle = '#3498db'; ctx.beginPath(); ctx.arc(dx, dy, 4, 0, Math.PI*2); ctx.fill(); }
    }
}

class FloatText {
    constructor(x, y, text, color='#fff') { this.x = x; this.y = y; this.text = text; this.life = 0.8; this.color = color; this.markedForDeath = false; }
    update(dt) { this.y -= 40 * dt; this.life -= dt; if(this.life <= 0) this.markedForDeath = true; }
    draw(ctx, cam) { ctx.fillStyle = this.color; ctx.globalAlpha = Math.min(1, this.life * 2); ctx.fillText(this.text, this.x - cam.x, this.y - cam.y); ctx.globalAlpha = 1.0; }
}

/** ==========================================
 *  四、主迴圈與渲染控制 (Main Loop)
