const keys = {};
window.addEventListener('keydown', e => keys[e.key.toLowerCase()] = true);
window.addEventListener('keyup', e => keys[e.key.toLowerCase()] = false);

function update() {
    if(!gameState.isRunning) return;
    let now = performance.now(); 
    if (window.GG.runtime.last_frame_time === null) { window.GG.runtime.last_frame_time = now; requestAnimationFrame(update); return; }
    let dtMs = now - window.GG.runtime.last_frame_time; window.GG.runtime.last_frame_time = now;
    if (dtMs <= 0 || dtMs > 250) { requestAnimationFrame(update); return; }
    
    let dt = dtMs / 1000; gameState.time += dt;

    if(keys['w'] || keys['arrowup']) kbInput.y = -1; else if(keys['s'] || keys['arrowdown']) kbInput.y = 1; else kbInput.y = 0;
    if(keys['a'] || keys['arrowleft']) kbInput.x = -1; else if(keys['d'] || keys['arrowright']) kbInput.x = 1; else kbInput.x = 0;

    try {
        player.update(dt); 
        companions.forEach(c => c.update(dt)); companions = companions.filter(c => !c.markedForDeath);
        
        let r = Math.max(canvas.width, canvas.height) / 2 + 50;
        spawnerTimer += dt;
        let targetDelay = window.GG.wave.tick(dt, gameState.time, gameState.maxTime, enemies.length);
        if (targetDelay !== null && spawnerTimer > targetDelay) { 
            spawnerTimer = 0; let ang = Math.random() * Math.PI * 2; 
            let type = Math.random() < 0.05 ? 'elite_blood' : 'normal';
            enemies.push(new Enemy(player.x + Math.cos(ang)*r, player.y + Math.sin(ang)*r, type)); 
        }

        projectiles.forEach(p => p.update(dt)); projectiles = projectiles.filter(p => !p.markedForDeath);
        enemies.forEach(e => e.update(dt)); enemies = enemies.filter(e => !e.markedForDeath);
        drops.forEach(d => d.update(dt)); drops = drops.filter(d => !d.markedForDeath);
        floatTexts.forEach(f => f.update(dt)); floatTexts = floatTexts.filter(f => !f.markedForDeath);

        let rem = Math.max(0, gameState.maxTime - gameState.time); let mins = Math.floor(rem / 60); let secs = Math.floor(rem % 60);
        UI.timer.innerText = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        UI.stats.innerHTML = `境界: ${window.GG.state.player.realm} ${window.GG.state.player.level} 層<br>靈石: ${window.GG.state.inventory.spirit_stones} | 妖丹: ${window.GG.state.inventory.cores}<br>氣血: ${Math.floor(window.GG.state.player.hp_current)}/${window.GG.state.player.hp_max}`;

        draw();
    } catch(err) { console.error("迴圈錯誤防護攔截：", err); }
    requestAnimationFrame(update);
}

function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height); ctx.strokeStyle = '#222'; ctx.lineWidth = 2; let gridSize = 100;
    let ox = -(gameState.camera.x % gridSize); let oy = -(gameState.camera.y % gridSize);
    ctx.beginPath(); for(let x = ox; x < canvas.width; x += gridSize) { ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); } for(let y = oy; y < canvas.height; y += gridSize) { ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); } ctx.stroke();

    drops.forEach(d => d.draw(ctx, gameState.camera)); companions.forEach(c => c.draw(ctx, gameState.camera));

    if(player && window.GG.state.player.hp_current > 0) {
        let pPos = { x: player.x - gameState.camera.x, y: player.y - gameState.camera.y };
        let avatarCache = window.GG.avatar.getPlayerCache();
        if (avatarCache) { ctx.drawImage(avatarCache, pPos.x - 32, pPos.y - 32); }
        else { ctx.fillStyle = '#3498db'; ctx.beginPath(); ctx.arc(pPos.x, pPos.y, player.radius, 0, Math.PI*2); ctx.fill(); }
        ctx.fillStyle = 'red'; ctx.fillRect(pPos.x - 15, pPos.y + 35, 30, 4); ctx.fillStyle = '#2ecc71'; ctx.fillRect(pPos.x - 15, pPos.y + 35, 30 * (Math.max(0, window.GG.state.player.hp_current)/window.GG.state.player.hp_max), 4);
    }

    enemies.forEach(e => {
        let pos = { x: e.x - gameState.camera.x, y: e.y - gameState.camera.y };
        ctx.fillStyle = 'rgba(0,0,0,0.4)'; ctx.beginPath(); ctx.ellipse(pos.x, pos.y + e.radius*0.7, e.radius*0.9, e.radius*0.4, 0, 0, Math.PI*2); ctx.fill();
        ctx.fillStyle = e.color; ctx.beginPath(); ctx.arc(pos.x, pos.y, e.radius, 0, Math.PI*2); ctx.fill();
        if(e.hp < e.maxHp) { ctx.fillStyle = 'red'; ctx.fillRect(pos.x - 12, pos.y - e.radius - 8, 24, 3); ctx.fillStyle = '#2ecc71'; ctx.fillRect(pos.x - 12, pos.y - e.radius - 8, 24 * (e.hp/e.maxHp), 3); }
    });

    projectiles.forEach(p => p.draw(ctx, gameState.camera));
    ctx.font = "bold 14px Arial"; ctx.textAlign = "center"; floatTexts.forEach(f => f.draw(ctx, gameState.camera));
}

function takePlayerDamage(dmg) {
    let finalDmg = Math.max(1, dmg - window.GG.state.player.def);
    window.GG.res.sub('hp', finalDmg);
    UI.dmgOverlay.style.opacity = 1; setTimeout(() => UI.dmgOverlay.style.opacity = 0, 150);
    if(window.GG.state.player.hp_current <= 0) gameOver(); 
}

function triggerLevelUp() {
    gameState.isRunning = false; UI.levelUpModal.style.display = 'block';
    const basePool = [{ name: '清風劍訣', desc: '提升基礎劍氣傷害與頻率', action: () => player.addWeapon('清風劍氣', 'projectile', 15, 1.0, 'normal', 1) }];
    let options = basePool; UI.optionsContainer.innerHTML = '';
    options.forEach(opt => {
        let div = document.createElement('div'); div.className = 'card';
        div.innerHTML = `<div class="card-title">${opt.name}</div><div style="font-size:12px; margin-top:5px; color:#aaa;">${opt.desc}</div>`;
        div.onclick = () => { opt.action(); UI.levelUpModal.style.display = 'none'; gameState.lastTime = performance.now(); gameState.isRunning = true; requestAnimationFrame(update); };
        UI.optionsContainer.appendChild(div);
    });
}

function togglePause() {
    if(gameState.isRunning) { gameState.isRunning = false; UI.pauseModal.style.display = 'block'; } 
    else { UI.pauseModal.style.display = 'none'; gameState.lastTime = performance.now(); gameState.isRunning = true; requestAnimationFrame(update); }
}

function gameOver() {
    if(!gameState.isRunning) return; gameState.isRunning = false; UI.gameOverModal.style.display = 'block';
    window.GG.save.save(window.GG.state);
}

/** ==========================================
 *  五、局外 HUB 與 創角引導 (UI & Hub)
 *  ========================================== */
let tempPlayerState = null;
function switchStartStep(step) {
    document.getElementById('ui-step-1').style.display = 'none'; document.getElementById('ui-step-2').style.display = 'none'; document.getElementById('ui-step-3').style.display = 'none';
    document.getElementById(`ui-step-${step}`).style.display = 'block';
    if(step === 2 && !tempPlayerState) rollStats(); 
}

function rollStats() {
    SoundManager.init(); SoundManager.hit();
    tempPlayerState = { hp_max: 100, mp_max: 50, atk: 10, def: 5, int: 80, luck: 80, traits: [] };
    let pool = [...window.GG.traits]; let idx = Math.floor(Math.random() * pool.length);
    tempPlayerState.traits.push(pool[idx]);
    
    document.getElementById('roll-hp').innerText = tempPlayerState.hp_max; document.getElementById('roll-atk').innerText = tempPlayerState.atk; document.getElementById('roll-def').innerText = tempPlayerState.def;
    document.getElementById('roll-traits').innerHTML = `<div style="color:${tempPlayerState.traits[0].color}; font-weight:bold;">【${tempPlayerState.traits[0].name}】</div><div style="font-size:12px; color:#aaa;">${tempPlayerState.traits[0].desc}</div>`;
}

function applyStatsAndNext() {
    if(!tempPlayerState) return;
    let p = window.GG.state.player;
    p.hp_max = tempPlayerState.hp_max; p.hp_current = p.hp_max; p.atk = tempPlayerState.atk; p.def = tempPlayerState.def;
    tempPlayerState.traits.forEach(t => t.apply(p));
    switchStartStep(3);
}

function hoverSect(sect) {
    let text = sect === 'sword' ? "「青雲劍宗，御劍術聞名八荒。」" : (sect === 'magic' ? "「焚天谷，匯聚天下靈火。」" : "「極道體宗，肉身即是法寶。」");
    document.getElementById('sect-dialogue').innerText = text;
}
function selectSectDialogue(sect) { chosenSect = sect; document.getElementById('time-selection-new').style.display = 'block'; }
function confirmStart(timeLimit) {
    document.getElementById('start-modal').style.display = 'none'; UI.layer.style.display = 'block';
    gameState.maxTime = timeLimit; gameState.spawns = {}; gameState.sosSpawned = false; 
    player = new Player(chosenSect); companions = [];
    gameState.lastTime = performance.now(); gameState.isRunning = true;
    requestAnimationFrame(update);
}

// HUB 控制
const shopCatalog = [
    { id: 'p_atk', name: '一品攻擊靈果', desc: '永久提升基礎攻擊力 +2', cost: 50, stat: 'atk', val: 2 },
    { id: 'p_def', name: '一品防禦靈果', desc: '永久提升基礎防禦力 +2', cost: 40, stat: 'def', val: 2 }
];
let hubReturnTo = 'start';
function openHub(from, tab='shop') {
    SoundManager.init(); hubReturnTo = from;
    document.getElementById('start-modal').style.display = 'none'; UI.pauseModal.style.display = 'none'; UI.gameOverModal.style.display = 'none';
    document.getElementById('hub-modal').style.display = 'block'; switchHubTab(tab);
}
function closeHub() {
    document.getElementById('hub-modal').style.display = 'none';
    if(hubReturnTo === 'start') document.getElementById('start-modal').style.display = 'block';
    else UI.pauseModal.style.display = 'block';
}
function switchHubTab(tab) {
    document.querySelectorAll('#hub-modal .nav-tab').forEach(e => e.classList.remove('active'));
    document.getElementById('tab-'+tab).classList.add('active');
    document.getElementById('hub-stones').innerText = window.GG.state.inventory.spirit_stones;
    document.getElementById('hub-cores').innerText = window.GG.state.inventory.cores;
    let html = '';
    if(tab === 'shop') {
        shopCatalog.forEach(item => {
            html += `<div class="card" style="display:flex; justify-content:space-between; align-items:center;">
                <div><div class="card-title">${item.name}</div><div style="font-size:12px; color:#aaa;">${item.desc}</div></div>
                <div><button class="btn" onclick="buyShopItem('${item.stat}', ${item.cost}, ${item.val})">${item.cost} 靈石購買</button></div></div>`;
        });
    } else if(tab === 'cave') {
        let p = window.GG.state.player;
        html += `<div style="text-align:center; padding:15px;"><h3 style="color:#2ecc71;">當前境界：${p.realm} (${p.level}層)</h3><button class="btn" style="background:#2ecc71; color:#000;" onclick="breakthroughRealm()">嘗試突破境界 (需5妖丹)</button></div>`;
    } else {
        html += `<div style="text-align:center; color:#777; padding:20px;">此功能於 Demo-007 開放中</div>`;
    }
    document.getElementById('hub-content').innerHTML = html;
}
function buyShopItem(stat, cost, val) {
    if(window.GG.state.inventory.spirit_stones >= cost) {
        window.GG.state.inventory.spirit_stones -= cost; window.GG.state.player[stat] += val;
        window.GG.save.save(window.GG.state); switchHubTab('shop'); SoundManager.pickup();
    } else alert("靈石不足！");
}
function breakthroughRealm() {
    let inv = window.GG.state.inventory;
    if(inv.cores >= 5) {
        inv.cores -= 5; let p = window.GG.state.player; p.atk += 15; p.hp_max += 200; p.hp_current = p.hp_max;
        p.realm = p.realm === '練氣期' ? '築基期' : '結丹期';
        window.GG.save.save(window.GG.state); alert(`突破成功！當前境界：${p.realm}`); switchHubTab('cave');
    } else alert("妖丹不足！");
}

setTimeout(() => { if(document.getElementById('avatar-preview-canvas')) window.GG.avatar.refreshPlayerPreview(); }, 100);
</script>
